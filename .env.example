# Porta da API
PORT=3333
# Em produção, defina NODE_ENV=production (cookies "secure", sem links de dev)
NODE_ENV=development
# URL pública do app (usada em links de redefinição de senha)
APP_URL=http://localhost:5173
# Banco: arquivo local por padrão. Em produção, use o Turso (gratuito, permanente):
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=...
DATABASE_PATH=./data/walisson.db
# Número de proxies na frente do app (Nginx, Cloudflare...) para IP real no rate limit
TRUST_PROXY=0
# Taxa de comissão padrão (%)
COMMISSION_RATE=6
# Conta do administrador, criada automaticamente na primeira inicialização (banco vazio).
# Defina no .env local ou no painel da hospedagem — nunca no código.
ADMIN_NAME=Walisson
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcional: popular com dados de demonstração (imóveis, leads, corretores fictícios)
# SEED_DEMO=true
# DEMO_MODE=true
